<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logging configuration for the Insurance backend.

    - dev/test: human-readable, colored console output (easy to read while developing).
    - prod:     structured JSON logs to stdout (ready for log aggregators like ELK/CloudWatch/
                Datadog) PLUS a rolling file appender on disk as a local fallback.

    MDC fields "requestId", "method", "path", "status" and "durationMs" are populated by
    RequestLoggingFilter for every HTTP request and automatically show up in both the console
    pattern and the JSON output below, so log lines from the same request can be correlated.
-->
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProfile name="dev,test,default">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) %X{requestId:-} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <logger name="com.insurance" level="DEBUG"/>
        <logger name="org.springframework.security" level="INFO"/>
    </springProfile>

    <springProfile name="prod">
        <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>method</includeMdcKeyName>
                <includeMdcKeyName>path</includeMdcKeyName>
                <includeMdcKeyName>status</includeMdcKeyName>
                <includeMdcKeyName>durationMs</includeMdcKeyName>
                <customFields>{"application":"insurance-backend"}</customFields>
            </encoder>
        </appender>

        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/insurance-backend.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>logs/insurance-backend.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>2GB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>method</includeMdcKeyName>
                <includeMdcKeyName>path</includeMdcKeyName>
                <includeMdcKeyName>status</includeMdcKeyName>
                <includeMdcKeyName>durationMs</includeMdcKeyName>
                <customFields>{"application":"insurance-backend"}</customFields>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
            <appender-ref ref="FILE"/>
        </root>

        <logger name="com.insurance" level="INFO"/>
        <logger name="org.springframework.security" level="WARN"/>
        <!-- Never log SQL / bind parameters in prod (they can contain PII) -->
        <logger name="org.hibernate.SQL" level="WARN"/>
    </springProfile>

</configuration>
